ENV=dev
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/ecom_ops?charset=utf8mb4
# 生产必须改为强随机值；dev 可用 change-me。
# ENV=prod 时留空或仍为 change-me 会拒绝启动。
API_KEY=change-me
# 生产必须设置；留空时敏感配置加密不可用。
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
TIMEZONE=Asia/Shanghai
WAREHOUSE_LAYOUT=single_db
WAREHOUSE_DATABASE=ecom_ops
LOG_JSON=false
ENABLE_SCHEDULER=false
JOB_DIR=jobs
MODEL_DIR=models
METRICS_FILE=metrics/metrics.yml

# 抖店开放平台（M1 可选；对应 API Job 默认 enabled: false）
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_ACCESS_TOKEN=
DOUYIN_REFRESH_TOKEN=
DOUYIN_SHOP_ID=
DOUYIN_BASE_URL=https://openapi-fxg.jinritemai.com

# 千川开放平台（M1 使用长期 access token，不做 OAuth 刷新）
QIANCHUAN_ACCESS_TOKEN=
# advertiser_id:aweme_id，多个用逗号分隔
QIANCHUAN_ADVERTISER_PAIRS=
QIANCHUAN_BASE_URL=https://api.oceanengine.com/open_api

# CSV 兜底目录与字段映射
CSV_IMPORT_DIR=data/csv
CSV_MAPPINGS_DIR=app/adapters/csv/mappings
HTTP_TIMEOUT_SECONDS=20
